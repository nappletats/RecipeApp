# Drizzle
# Local dev: DATABASE_URL=file:local.db, TURSO_AUTH_TOKEN unset
# Production: DATABASE_URL=libsql://your-db.turso.io, TURSO_AUTH_TOKEN=<token from Turso dashboard>
DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Auth
# Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 12)).toString('base64'))"
APP_PASSWORD_HASH_B64=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
