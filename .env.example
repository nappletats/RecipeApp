# Drizzle — the app always connects to Turso over HTTP (no local-file mode),
# so this is required for local dev too. Same values in both environments.
# DATABASE_URL=libsql://your-db.turso.io, TURSO_AUTH_TOKEN=<token from Turso dashboard>
DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth
# Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 12)).toString('base64'))"
APP_PASSWORD_HASH_B64=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# adapter-node's own request body cap (default 512K) — raised for photo-scan
# uploads. Only enforced in the production build (`node build`), not `vite dev`.
BODY_SIZE_LIMIT=15M
